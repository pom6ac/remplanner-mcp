           Угол рассвета:\n                <div class=\"contextmenu_item_input\">\n                    <input class=\"numeric\" data-input=\"angle\" type=\"text\" maxlength=\"3\" value=\"\" placeholder=\"0\">\n                    <span>ОК</span><em>°</em>\n                </div>\n            </div>\n            <div class=\"contextmenu_item input\" data-input-container=\"sill-thinkness\">\n                Толщина подоконника:\n                <div class=\"contextmenu_item_input\">\n                    <input class=\"numeric\" data-input=\"sill-thinkness\" type=\"text\" maxlength=\"4\" value=\"\" placeholder=\"4\">\n                    <span>ОК</span><em class=\"project-units\">см</em>\n                </div>\n            </div>\n            <div class=\"contextmenu_item input\" data-input-container=\"sill-overhang\">\n                Вылет подоконника:\n                <div class=\"contextmenu_item_input\">\n                    <input class=\"numeric\" data-input=\"sill-overhang\" type=\"text\" maxlength=\"4\" value=\"\" placeholder=\"0\">\n                    <span>ОК</span><em class=\"project-units\">см</em>\n                </div>\n            </div>\n            <div class=\"contextmenu_item input\" data-input-container=\"sill-overmeasure\">\n                Выпуски подоконника:\n                <div class=\"contextmenu_item_input\">\n                    <input class=\"numeric\" data-input=\"sill-overmeasure\" type=\"text\" maxlength=\"4\" value=\"\" placeholder=\"0\">\n                    <span>ОК</span><em class=\"project-units\">см</em>\n                </div>\n            </div>\n            <div class=\"contextmenu_item switch pointer\" data-switcher-container=\"arc\" style=\"\">\n                <div class=\"footer_bar_tool_switch\" data-switcher=\"arc\"><span></span></div>\n                Арочный проем\n            </div>\n            <div class=\"contextmenu_item icons\">\n                <em>Действия:</em>\n                <div class=\"contextmenu_item